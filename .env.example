# Server-side secret used by /api/chameleon/uid-hash to compute HMAC-SHA256(userId)
CHAMELEON_VERIFICATION_SECRET=replace-with-secure-random-secret

# Optional frontend identity/profile fields for Chameleon identify payload
VITE_CHAMELEON_USER_ID=
VITE_CHAMELEON_UID_HASH=
VITE_CHAMELEON_EMAIL=
VITE_CHAMELEON_NAME=
VITE_CHAMELEON_FULL_NAME=
VITE_CHAMELEON_ACCOUNT_CREATED_AT=
VITE_CHAMELEON_ROLE=
VITE_CHAMELEON_JOB_TITLE=
VITE_CHAMELEON_ITEMS_CREATED=0
VITE_CHAMELEON_DEPARTMENT=
VITE_CHAMELEON_SENIORITY=
